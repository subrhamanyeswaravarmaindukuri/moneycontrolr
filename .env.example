# MoneyControlr Environment Variables Template
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-supabase-anon-key

# Public Production Domain (Configure in Vercel Production/Preview environments; do NOT use localhost in production)
# Example: https://moneycontrolr.com or https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:5000

# Optional Server-Only Contact Form Delivery (NEVER prefix with NEXT_PUBLIC_)
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=

